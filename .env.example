APP_NAME="EPICURE PIZZA & FAST FOOD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Karachi
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_me
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
# Generate a long random secret outside GitHub, set it temporarily for owner setup, then remove it.
EPICURE_SETUP_SECRET=
