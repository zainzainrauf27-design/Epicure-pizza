{
  "name": "epicure/restaurant",
  "type": "project",
  "description": "EPICURE PIZZA & FAST FOOD restaurant ordering and management application",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "require-dev": {"phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "@php artisan test", "post-autoload-dump": ["@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true}
}
